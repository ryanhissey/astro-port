---
interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<div class="flex flex-col rounded-2xl border border-brand-600/50 bg-brand-700/50 backdrop-blur-sm p-6">
	<h3 class="text-base font-semibold text-brand-50">{title}</h3>
	<p class="mt-2 text-sm text-brand-100/70">{description}</p>
</div>
