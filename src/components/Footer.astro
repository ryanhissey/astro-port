---
import { SITE_TITLE } from '../consts';

const today = new Date();
---

<footer class="border-t border-brand-600/40 mt-24">
	<div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-6 px-4 py-10 sm:flex-row sm:px-6 lg:px-8">
		<nav class="flex gap-6">
			<a href="/" class="text-sm text-brand-100/70 transition hover:text-brand-50">Home</a>
			<a href="/about" class="text-sm text-brand-100/70 transition hover:text-brand-50">About</a>
			<a href="/services" class="text-sm text-brand-100/70 transition hover:text-brand-50">Services</a>
			<a href="/projects" class="text-sm text-brand-100/70 transition hover:text-brand-50">Projects</a>
		</nav>
		<p class="text-sm text-brand-100/65">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" class="inline-block h-4 w-4 align-[-3px]">
				<circle cx="12" cy="12" r="5.5" />
				<path d="M3.2 15.2c-1.1-.9-1.6-1.8-1.3-2.6.6-1.7 4.4-2.2 9.4-1.4M20.8 8.8c1.1.9 1.6 1.8 1.3 2.6-.6 1.7-4.4 2.2-9.4 1.4" />
			</svg>
			&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.
		</p>
	</div>
</footer>
