---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Starfield from '../components/Starfield.astro';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body class="bg-brand-800 text-brand-50 antialiased overflow-x-hidden">
		<!-- Background accents -->
		<div class="pointer-events-none fixed inset-0 z-0 overflow-hidden" aria-hidden="true">
			<!-- Nebula haze — top right, warm purple-indigo -->
			<div class="bg-glow-primary animate-nebula absolute -top-32 -right-20 h-[700px] w-[500px] rounded-full opacity-[0.13] blur-[130px]"></div>

			<!-- Nebula haze — mid-left, cooler blue with a hint of cyan -->
			<div class="bg-glow-secondary animate-nebula-2 absolute top-[35%] -left-32 h-[550px] w-[400px] rounded-full opacity-10 blur-[120px]"></div>

			<!-- Nebula haze — bottom center-right, subtle magenta tint -->
			<div class="bg-glow-accent animate-nebula absolute -bottom-24 right-[10%] h-[450px] w-[450px] rounded-full opacity-[0.07] blur-[110px]"></div>

			<!-- Small highlight — top left, faint warm spot -->
			<div class="bg-glow-highlight animate-nebula-2 absolute top-[15%] left-[10%] h-[250px] w-[250px] rounded-full opacity-[0.05] blur-[80px]"></div>

			<Starfield />

			<!-- Film grain -->
			<div class="bg-noise absolute inset-0 opacity-[0.04] mix-blend-overlay"></div>
		</div>

		<div class="relative z-10 flex min-h-screen flex-col">
			<Header />
			<main class="mt-16 flex-1">
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>
