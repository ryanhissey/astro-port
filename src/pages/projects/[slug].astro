---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Badge from '../../components/Badge.astro';
import { SITE_TITLE } from '../../consts';

// Only projects with a written body get their own page; the rest link straight out from their card.
export async function getStaticPaths() {
	const projects = await getCollection('projects', (project) => Boolean(project.body?.trim()));
	return projects.map((project) => ({
		params: { slug: project.id },
		props: project,
	}));
}

type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const { title, description, url, tags, screenshot } = project.data;
const { Content } = await render(project);
const linkHostname = url ? new URL(url).hostname.replace(/^www\./, '') : null;
---

<BaseLayout title={`${title} - ${SITE_TITLE}`} description={description} image={screenshot}>
	<Container class="pt-16 sm:pt-24">
		<div class="mx-auto max-w-3xl">
			<a href="/projects/" class="group mb-8 inline-flex items-center gap-2 text-sm text-brand-100/70 transition hover:text-brand-200">
				<svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="h-4 w-4 stroke-current">
					<path d="M7.25 11.25 3.75 8m0 0 3.5-3.25M3.75 8h8.5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
				Back to projects
			</a>

			<article>
				<header class="mb-10">
					<h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">{title}</h1>
					<p class="mt-6 text-base text-brand-100/80">{description}</p>
					<div class="mt-6 flex flex-wrap items-center gap-4">
						{tags.length > 0 && (
							<div class="flex flex-wrap gap-2">
								{tags.map((tag) => <Badge size="sm">{tag}</Badge>)}
							</div>
						)}
						{url && linkHostname && (
							<a
								href={url}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-brand-50 ring-1 ring-brand-500/50 transition hover:bg-brand-500 hover:ring-brand-400/50"
							>
								<svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke="currentColor" class="h-4 w-4" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
								</svg>
								Visit {linkHostname}
							</a>
						)}
					</div>
				</header>

				{screenshot && (
					<Image
						src={screenshot}
						alt={`${title} homepage`}
						width={1200}
						loading="eager"
						class="mb-12 w-full rounded-2xl shadow-lg shadow-brand-800/50 ring-1 ring-brand-500/20"
					/>
				)}

				<div class="prose prose-lg max-w-none">
					<Content />
				</div>
			</article>
		</div>
	</Container>
</BaseLayout>
