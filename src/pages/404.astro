---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout title={`Page not found — ${SITE_TITLE}`} description="This page drifted off into space.">
	<Container class="flex flex-col items-center py-24 text-center sm:py-32">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" aria-hidden="true" class="h-32 w-32 text-brand-200/60">
			<circle cx="12" cy="12" r="5.5" />
			<path d="M3.2 15.2c-1.1-.9-1.6-1.8-1.3-2.6.6-1.7 4.4-2.2 9.4-1.4M20.8 8.8c1.1.9 1.6 1.8 1.3 2.6-.6 1.7-4.4 2.2-9.4 1.4" />
		</svg>
		<p class="mt-8 text-sm font-medium uppercase tracking-wider text-brand-100/50">404</p>
		<h1 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">Lost in space</h1>
		<p class="mt-4 max-w-md text-base text-brand-100/80">
			This page drifted out of orbit. It might have been moved, deleted, or never existed at all.
		</p>
		<a
			href="/"
			class="mt-8 rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-medium text-brand-50 ring-1 ring-brand-500/50 transition hover:bg-brand-500 hover:ring-brand-400/50"
		>
			Back to Earth
		</a>
	</Container>
</BaseLayout>
